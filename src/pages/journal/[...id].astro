---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publishedEntries, type JournalEntry } from '../../lib/content';
export async function getStaticPaths() {
  return (await publishedEntries()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: JournalEntry; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<SiteLayout title={entry.data.title} description={entry.data.description}>
  <h1>{entry.data.title}</h1>
  <Content />
</SiteLayout>
