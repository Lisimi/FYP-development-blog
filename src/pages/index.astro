---
import SiteLayout from '../layouts/SiteLayout.astro';
import { publishedEntries, url } from '../lib/content';
import EntryCard from '../components/EntryCard.astro';
import { gallery } from '../data/gallery';
const entries = await publishedEntries();
const latest = entries[0];
---
<SiteLayout title="Development journal">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-line"></span>THE BAMBOO VANGUARD DEVLOG</p>
      <h1>A small panda.<br />A <em>growing</em> world.</h1>
      <p class="hero-description">Three students. Two forms. One game taking shape.<br class="desktop-break" /> Follow the ideas, experiments and little breakthroughs behind our dual-form action game.</p>
      <div class="hero-actions"><a class="button" href={url('journal/')}>Explore the journal <span aria-hidden="true">↗</span></a><a class="text-link" href={url('gallery/')}>Meet Pando <span aria-hidden="true">→</span></a></div>
      <div class="hero-footnote"><span class="status-dot"></span>Currently prototyping <span class="meta-divider">/</span> Unity + Blender</div>
    </div>
    <figure class="hero-visual">
      <img src={url('images/pando-hold.png')} alt="Pando, our panda character, holding a bamboo-inspired gun" width="800" height="800" fetchpriority="high" />
      <div class="hero-visual-top"><span>CHARACTER STUDY</span><span>NO. 008</span></div>
      <figcaption><span><strong>Hello, Pando.</strong><small>Original character · Blender motion study</small></span><a href={url('gallery/')} aria-label="Explore Pando model studies">↗</a></figcaption>
    </figure>
  </section>
  <div class="project-strip"><div class="wrap"><span><strong>01</strong> A dual-form action game</span><span><strong>02</strong> Gameplay & character art</span><span><strong>03</strong> People building together</span><span class="strip-year">FINAL YEAR PROJECT / 2026–27</span></div></div>
  <section class="section wrap">
    <div class="section-heading"><div><p class="eyebrow">THE LATEST CHAPTER</p><h2>Notes from the workshop.</h2></div><a class="text-link" href={url('journal/')}>All entries <span aria-hidden="true">↗</span></a></div>
    {latest ? <EntryCard entry={latest} /> : <p>Our first development update is on its way.</p>}
  </section>
  <section class="section process-section"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">THE IDEA BEHIND THE GAME</p><h2>Two forms. A different way to play.</h2></div><p class="section-intro">An Android action game built around the contrast between deliberate aiming and playful momentum.</p></div>
    <div class="process-grid">
      <article><span class="step-number">01 / GAMEPLAY</span><h3>Find the feel.</h3><p>Charge, roll, bounce and change direction. We test the movement first, then build the battles around it.</p><a class="text-link" href={url('journal/october-2026/#3-programming-progress')}>Programming notes →</a></article>
      <article><span class="step-number">02 / CHARACTER</span><h3>Give it personality.</h3><p>A panda in a green vest, a bamboo-inspired blaster, and the challenge of folding it all into a ball.</p><a class="text-link" href={url('gallery/')}>Character studies →</a></article>
      <article><span class="step-number">03 / PROCESS</span><h3>Keep the rough edges.</h3><p>Good tests, difficult poses and lessons learned. This journal follows the work, including what still needs another try.</p><a class="text-link" href={url('team/')}>Meet the team →</a></article>
    </div>
  </div></section>
  <section class="section wrap">
    <div class="section-heading"><div><p class="eyebrow">FROM THE ART DESK</p><h2>A character taking shape.</h2></div><a class="text-link" href={url('gallery/')}>Visit the gallery <span aria-hidden="true">↗</span></a></div>
    <div class="art-grid">{gallery.slice(1).map((item) => <a class="art-card" href={url('gallery/')}><div class="art-image"><img src={url(item.file)} alt={item.alt} width="800" height="800" loading="lazy" /><span>{item.version}</span></div><div class="art-caption"><div><small>{item.label}</small><h3>{item.shortTitle}</h3></div><span aria-hidden="true">↗</span></div></a>)}</div>
  </section>
  <section class="closing-note wrap"><span class="eyebrow">STILL IN THE MAKING</span><h2>Every small step<br />makes a better game.</h2><a class="button button-light" href={url('journal/')}>Follow our progress <span aria-hidden="true">↗</span></a><span class="closing-symbol" aria-hidden="true">竹</span></section>
</SiteLayout>
