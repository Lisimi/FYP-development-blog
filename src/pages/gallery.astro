---
import SiteLayout from '../layouts/SiteLayout.astro';
import { gallery } from '../data/gallery';
import { url } from '../lib/content';
---
<SiteLayout title="Character gallery">
  <section class="page-heading wrap"><p class="eyebrow">FROM THE ART DESK</p><h1>A panda.<br /><em>Many possibilities.</em></h1><p>Real model renders, early poses and experiments from our October character work. Made in Blender by the character art workstream.</p></section>
  <section class="gallery-grid wrap" aria-label="Panda model studies">{gallery.map((item, index) => <figure class="gallery-item"><a class="gallery-open" href={url(item.file)} data-title={item.shortTitle} data-description={item.description} aria-label={`Enlarge ${item.shortTitle}`}><img src={url(item.file)} alt={item.alt} width="800" height="800" loading={index === 0 ? 'eager' : 'lazy'} /><span class="gallery-enlarge" aria-hidden="true">↗</span></a><figcaption><div class="gallery-meta"><span>{String(index + 1).padStart(2, '0')} / {item.label}</span><span>{item.version}</span></div><h2>{item.title}</h2><p>{item.description}</p></figcaption></figure>)}</section>
  <section class="gallery-note wrap"><span class="eyebrow">A NOTE ON THE PROCESS</span><p>These are character studies, not in-game screenshots. The custom panda is awaiting Unity integration, and the curl is still being refined.</p><a class="text-link" href={url('journal/october-2026/#4-character-modelling-progress')}>Read the modelling notes ↗</a></section>
  <dialog id="image-viewer" aria-labelledby="viewer-title"><button class="dialog-close" aria-label="Close image">Close <span aria-hidden="true">×</span></button><img id="viewer-image" alt="" /><div class="viewer-caption"><h2 id="viewer-title"></h2><p id="viewer-description"></p></div></dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#image-viewer');
    const image = document.querySelector<HTMLImageElement>('#viewer-image');
    const title = document.querySelector<HTMLElement>('#viewer-title');
    const description = document.querySelector<HTMLElement>('#viewer-description');
    document.querySelectorAll<HTMLAnchorElement>('.gallery-open').forEach(link => link.addEventListener('click', event => {
      if (!dialog || !image || !title || !description || typeof dialog.showModal !== 'function') return;
      event.preventDefault();
      image.src = link.href;
      image.alt = link.querySelector('img')?.alt ?? '';
      title.textContent = link.dataset.title ?? '';
      description.textContent = link.dataset.description ?? '';
      dialog.showModal();
    }));
    document.querySelector('.dialog-close')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  </script>
</SiteLayout>
